{
  "name": "proyect-storage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build storage-manager --configuration production",
    "watch": "ng build storage-manager --watch --configuration development",
    "test": "ng test storage-manager --watch=false --browsers=ChromeHeadless",
    "docs": "compodoc -p tsconfig.doc.json -d documentation --name \"Storage Manager\" --language es-ES --coverageTest 100 --coverageMinimumPerFile 100 --coverageTestThresholdFail true",
    "docs:serve": "compodoc -s -d documentation -r 8080"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@compodoc/compodoc": "1.2.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@compodoc/compodoc": {
      "picomatch": "4.0.4"
    }
  }
}
