{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "storage-manager": {
      "projectType": "library",
      "root": "projects/storage-manager",
      "sourceRoot": "projects/storage-manager/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/storage-manager/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/storage-manager/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/storage-manager/tsconfig.spec.json",
            "codeCoverage": true,
            "polyfills": ["zone.js", "zone.js/testing"],
            "karmaConfig": "projects/storage-manager/karma.conf.js"
          }
        }
      }
    }
  }
}
